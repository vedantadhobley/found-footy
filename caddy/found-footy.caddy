# found-footy Caddy fragment (Go rebuild).
#
# ────── STATUS ─────────────────────────────────────────────────────────────
#
# This file is NOT read by the workspace Caddy yet. The workspace proxy
# currently uses "Option 1" from ~/workspace/proxy/CONVENTIONS.md:
# per-project fragments live centrally at
# ~/workspace/proxy/caddy/caddy.d/<project>.caddy. See
# ~/workspace/vedanta-dhobley/docs/todo.md § "Deferred — migrate per-
# project Caddy config to Option 2" for the eventual migration.
#
# Until that migration lands, this file is a non-loaded documentation copy of
# the current Go routing. Every block is commented out so it cannot take effect
# if someone runs Option 2 prematurely.
#
# Live dev and prod routing lives at
# ~/workspace/proxy/caddy/caddy.d/found-footy.caddy. Do not treat this copy as
# deployable configuration.

# ────── prod ──────────────────────────────────────────────────────────────

## Go API — typed HTTP read surface + share-id redirect (SSE is
## vedanta-systems'). Port :8081 = Chi read API; :8080 is internal metrics.
# http://found-footy-prod-api.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-prod-api:8081
# }

## Temporal UI.
# http://found-footy-prod-temporal-ui.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-prod-temporal-ui:8080
# }

## Garage admin UI — hostname vs reverse_proxy target must be
## byte-identical per CONVENTIONS.
# http://found-footy-prod-garage-web.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-prod-garage-web:3902
# }

## Twitter noVNC — gated behind the `vnc` compose profile in prod
## (manual cookie re-auth). Only reachable when that profile is active.
# http://found-footy-prod-twitter-vnc.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-prod-twitter-vnc:6080
# }

# ────── dev ───────────────────────────────────────────────────────────────

## Go API dev. Read API on :8081. The active dev entry lives in
## the proxy stack's found-footy.caddy; this is the documentation copy.
# http://found-footy-dev-api.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-dev-api:8081
# }

## Temporal UI dev.
# http://found-footy-dev-temporal-ui.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-dev-temporal-ui:8080
# }

## Garage admin dev.
# http://found-footy-dev-garage-web.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-dev-garage-web:3902
# }

## Twitter noVNC dev — the VNC container is opt-in via the compose profile.
# http://found-footy-dev-twitter-vnc.{$BASE_DOMAIN} {
#     reverse_proxy found-footy-dev-twitter-vnc:6080
# }
