#!/usr/bin/env bash
# pre-commit — fast engineering gate. Formatting, module metadata, vet, lint,
# compilation, and unit tests must all be clean before a commit is created.
# The integration/scenario suite remains at pre-push. Emergency bypass:
# `git commit --no-verify` (discouraged; see AGENTS.md). Installed via
# `make hooks` (sets core.hooksPath).
set -euo pipefail

printf '\n[pre-commit] make check-short (format + tidy + vet + lint + unit tests)…\n'
make check-short
printf '[pre-commit] ok — integration tests still run at pre-push\n'
