#!/usr/bin/env bash
# pre-push — full engineering gate. Rechecks source hygiene and static analysis,
# then runs the complete integration/testcontainers and scenario suite so no
# locally detectable regression can leave this machine.
# Emergency bypass: `git push --no-verify` (discouraged; see AGENTS.md).
# Installed via `make hooks` (sets core.hooksPath).
set -euo pipefail

printf '\n[pre-push] make check (all gates incl. integration tests)…\n'
make check
printf '[pre-push] ok\n'
