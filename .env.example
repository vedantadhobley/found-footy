# found-footy — canonical env template.
# Copy to `.env` and fill in the CHANGE_ME values.
# `.env` is gitignored; `.env.example` is versioned.

# ─── App Postgres ─────────────────────────────
PG_USER=ffuser
PG_PASSWORD=CHANGE_ME
PG_DSN=postgres://ffuser:CHANGE_ME@postgres:5432/found_footy?sslmode=disable

# ─── Blob storage (Garage; S3-compatible) ─────
S3_ENDPOINT=http://garage:3900
S3_BUCKET=found-footy
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_USE_PATH_STYLE=true
S3_REGION=garage

# ─── Temporal ─────────────────────────────────
TEMPORAL_HOSTPORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=found-footy
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=CHANGE_ME

# ─── NATS event bus (workspace-shared per decisions.md 2026-07-01) ─
# NATS runs at ~/workspace/nats/; found-footy attaches via luv-prod / luv-dev
# and authenticates with its per-project account creds file.
NATS_URL=nats://nats:4222
NATS_ACCOUNT=found-footy
NATS_CREDS_FILE=/etc/nats/found-footy.creds
# NATS_CLIENT_NAME: api + scaler containers override via `environment:` block
NATS_CLIENT_NAME=found-footy-worker
NATS_RECONNECT_WAIT=2s
# NATS_MAX_RECONNECTS: -1 = retry forever
NATS_MAX_RECONNECTS=-1
NATS_PING_INTERVAL=20s
# NATS_JS_DOMAIN: empty unless using leaf nodes
NATS_JS_DOMAIN=

# ─── LLM endpoint (nexus/gemma is the vision model; joi/Qwen is the alt) ─────
# Vision is the LLM's only consumer today. Pointed at nexus per the
# 2026-07-28 bake-off (gemma-4-12b). Caddy resolves nexus.luv → the gateway →
# nexus0 BC-250. Bring nexus up before running vision; the worker probes
# /v1/models at startup.
LLM_ENDPOINT_URL=http://nexus.luv
LLM_API_KEY=not-required
# LLM_CHAT_MODEL empty = discover from /v1/models (nexus serves gemma-4-12b)
LLM_CHAT_MODEL=gemma-4-12b
LLM_EMBEDDING_MODEL=
# LLM_CHAT_CONCURRENCY_CAP: per-worker client-side cap tracking the joi.luv
# gateway's node capacity (gemma --parallel 4 / max_slots=4). Stopgap until
# the control plane owns request queueing.
LLM_CHAT_CONCURRENCY_CAP=4

# ─── Video processing (ffmpeg) ───────────────
# The CPU + memory governor for frame extraction on this shared host.
# FFMPEG_MAX_CONCURRENT = clips extracted at once (the semaphore);
# FFMPEG_THREADS_PER_PROC bounds each ffmpeg's -threads. Total ffmpeg threads
# ≈ MAX_CONCURRENT × THREADS_PER_PROC. 32 × 1 = 32 = 1:1 with luv's 32 hardware
# threads (no oversubscription). Coupled to the worker mem_limit (16g in
# docker-compose.dev.yml): ~0.5g per concurrent ffmpeg. Streamed dense
# extraction keeps per-clip Go heap ~nil, so ffmpeg RSS is the only cost.
FFMPEG_MAX_CONCURRENT=32
FFMPEG_THREADS_PER_PROC=1
# Dedup params (DEDUP_FRAME_INTERVAL_SECS 0.1 / DEDUP_MIN_RUN_FRAMES 30 /
# DEDUP_MAX_GAP_FRAMES 3 / DEDUP_MAX_HAMMING 10) default in-code — a 3s,
# 30-frame @0.1s matching window tolerating 3 misses. Override only when
# recalibrating on live match-day data.

# ─── External APIs ────────────────────────────
API_FOOTBALL_KEY=CHANGE_ME
# API_FOOTBALL_TRACKED_LEAGUES: PL, La Liga, Bundesliga, Serie A, Ligue 1, World Cup.
# IngestWorkflow fetches the current-season roster for each and unions the
# team IDs into tracked_teams_cache. Fixtures are filtered to matches
# where at least one team is in that set.
API_FOOTBALL_TRACKED_LEAGUES=39,140,78,135,61,1
# API_FOOTBALL_TOP_FLIGHT_CACHE_HOURS: how stale tracked_teams_cache can get
# before Ingest re-fetches all league rosters. Mirrors Python's 24h cache.
API_FOOTBALL_TOP_FLIGHT_CACHE_HOURS=24
# API_FOOTBALL_FETCH_WINDOW_FUTURE_DAYS: how many days beyond today the
# smart-lookahead can scan when tomorrow is empty. Matches Python's 30-day
# MAX_LOOKAHEAD, long enough to bridge international breaks + off-season.
API_FOOTBALL_FETCH_WINDOW_FUTURE_DAYS=30

# ─── Workflow orchestration ──────────────────
# WORKFLOWS_STAGING_POLL_CRON: cron spec for StagingPollWorkflow's
# schedule. Default */15 * * * * = every 15 min on the wall clock,
# aligned to :00/:15/:30/:45. Split out from the single MonitorWorkflow
# in the 2026-07-11 workflow split (decisions.md).
WORKFLOWS_STAGING_POLL_CRON=*/15 * * * *
# WORKFLOWS_ACTIVE_FIXTURE_POLL_INTERVAL: ActivePollWorkflow's schedule
# interval — how often each cycle fires to poll ACTIVE fixtures via
# /fixtures?ids= batch call. Wired into the Temporal schedule spec.
WORKFLOWS_ACTIVE_FIXTURE_POLL_INTERVAL=30s
# WORKFLOWS_ACTIVATION_WINDOW: how far in advance a staging fixture is
# activated ahead of its start time. Tightened from 30m to 5m on
# 2026-07-11 — the 30s ActivePoll cadence makes long headroom
# unnecessary. Direct field now (previously derived from a multiplier
# × the staging poll interval, both removed in the workflow split).
WORKFLOWS_ACTIVATION_WINDOW=5m
# WORKFLOWS_RETENTION_DAYS: completed fixtures older than this get
# pruned by IngestWorkflow's PruneOldFixtures activity.
WORKFLOWS_RETENTION_DAYS=14

# ─── Discovery workflow tuning ───────────────
# DISCOVERY_MAX_ATTEMPTS: how many /search calls DiscoveryWorkflow issues
# per event. At DISCOVERY_ATTEMPT_SPACING=60s, this is the workflow's
# total lifetime in minutes. Default 15 (bumped from Python's 10 per
# 2026-07-23 user sign-off + wall-clock coverage decision).
DISCOVERY_MAX_ATTEMPTS=15
# DISCOVERY_ATTEMPT_SPACING: sleep between attempts. Do not jitter —
# Twitter's search response time (10-25s) already provides natural
# spacing variance.
DISCOVERY_ATTEMPT_SPACING=60s
# DISCOVERY_MAX_AGE_MINUTES: client-side age filter passed to T/c's
# /search endpoint. Candidates whose tweet age at scrape time exceeds
# this get dropped. Per twitter-search-query.md D4.
DISCOVERY_MAX_AGE_MINUTES=3
# DISCOVERY_QUERY_TIMEOUT: StartToCloseTimeout on a single SearchTweets
# activity. Hang-detection ceiling — typical /search finishes in 10-25s.
DISCOVERY_QUERY_TIMEOUT=2m

# ─── Twitter fleet ───────────────────────────
TWITTER_INSTANCE_URLS=http://twitter:8888

# ─── Auth (bearer token checked at Caddy edge) ─
FOUND_FOOTY_API_TOKEN=CHANGE_ME

# ─── Observability ───────────────────────────
LOG_LEVEL=INFO
# LOG_FORMAT=json         # or "text" for dev-friendly output; default json
# METRICS_ADDR=:8080      # /metrics + /healthz listen address; default :8080
# Loki always scrapes stdout; no per-project LOKI_ENABLED knob (removed
# in cleanup 2026-07-07 — speculative field, never had a real gating use).

# ─── Deploy tracking (usually baked at build via ldflags) ─
DEPLOY_ENV=prod

# ─── Host paths ──────────────────────────────
DATA_DIR=~/workspace/data/found-footy
BASE_DOMAIN=luv
