# found-footy — canonical env template.
# Copy to `.env` and fill in the CHANGE_ME values.
# `.env` is gitignored; `.env.example` is versioned.

# ─── App Postgres ─────────────────────────────
PG_USER=ffuser
PG_PASSWORD=CHANGE_ME
PG_DSN=postgres://ffuser:CHANGE_ME@postgres:5432/found_footy?sslmode=disable

# ─── Blob storage (Garage; S3-compatible) ─────
S3_ENDPOINT=http://garage:3900
S3_BUCKET=found-footy
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_USE_PATH_STYLE=true
S3_REGION=garage

# ─── Temporal ─────────────────────────────────
TEMPORAL_HOSTPORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=found-footy
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=CHANGE_ME

# ─── NATS event bus (workspace-shared per decisions.md 2026-07-01) ─
# NATS runs at ~/workspace/nats/; found-footy attaches via luv-prod / luv-dev
# and authenticates with its per-project account creds file.
NATS_URL=nats://nats:4222
NATS_ACCOUNT=found-footy
NATS_CREDS_FILE=/etc/nats/found-footy.creds
# NATS_CLIENT_NAME: api + scaler containers override via `environment:` block
NATS_CLIENT_NAME=found-footy-worker
NATS_RECONNECT_WAIT=2s
# NATS_MAX_RECONNECTS: -1 = retry forever
NATS_MAX_RECONNECTS=-1
NATS_PING_INTERVAL=20s
# NATS_JS_DOMAIN: empty unless using leaf nodes
NATS_JS_DOMAIN=

# ─── LLM endpoint (config-swappable joi → nexus per decisions.md 2026-07-01) ─
LLM_ENDPOINT_URL=http://llama-small.joi
LLM_API_KEY=not-required
# LLM_CHAT_MODEL empty = discover from /v1/models
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
# LLM_CHAT_CONCURRENCY_CAP: per-worker-process cap matching joi's parallel limit
LLM_CHAT_CONCURRENCY_CAP=2

# ─── External APIs ────────────────────────────
API_FOOTBALL_KEY=CHANGE_ME
# API_FOOTBALL_TRACKED_LEAGUES: PL, La Liga, Bundesliga, Serie A, Ligue 1, World Cup.
# IngestWorkflow fetches the current-season roster for each and unions the
# team IDs into tracked_teams_cache. Fixtures are filtered to matches
# where at least one team is in that set.
API_FOOTBALL_TRACKED_LEAGUES=39,140,78,135,61,1
# API_FOOTBALL_TOP_FLIGHT_CACHE_HOURS: how stale tracked_teams_cache can get
# before Ingest re-fetches all league rosters. Mirrors Python's 24h cache.
API_FOOTBALL_TOP_FLIGHT_CACHE_HOURS=24
# API_FOOTBALL_FETCH_WINDOW_FUTURE_DAYS: how many days beyond today the
# smart-lookahead can scan when tomorrow is empty. Matches Python's 30-day
# MAX_LOOKAHEAD, long enough to bridge international breaks + off-season.
API_FOOTBALL_FETCH_WINDOW_FUTURE_DAYS=30

# ─── Twitter fleet ───────────────────────────
TWITTER_INSTANCE_URLS=http://twitter:8888

# ─── Auth (bearer token checked at Caddy edge) ─
FOUND_FOOTY_API_TOKEN=CHANGE_ME

# ─── Observability ───────────────────────────
LOG_LEVEL=INFO
# LOG_FORMAT=json         # or "text" for dev-friendly output; default json
# METRICS_ADDR=:8080      # /metrics + /healthz listen address; default :8080
# Loki always scrapes stdout; no per-project LOKI_ENABLED knob (removed
# in cleanup 2026-07-07 — speculative field, never had a real gating use).

# ─── Deploy tracking (usually baked at build via ldflags) ─
DEPLOY_ENV=prod

# ─── Host paths ──────────────────────────────
DATA_DIR=~/workspace/data/found-footy
BASE_DOMAIN=luv
