# Dev image with air for hot-reload. Source is bind-mounted from the
# host in docker-compose.dev.yml; air watches for .go changes and
# rebuilds + restarts on save.
#
# One image for all four binaries; docker-compose.dev.yml sets
# BINARY per service and picks the matching .air.<binary>.toml.

FROM golang:1.23-bookworm

ARG BINARY
ENV BINARY=${BINARY}

# Base runtime deps + build tools for CGO if we ever need it later.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Twitter dev target: Firefox + Xvfb + noVNC (dev always includes VNC
# for cookie re-auth without stopping the container).
RUN if [ "$BINARY" = "twitter" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            firefox-esr \
            xvfb \
            x11vnc \
            novnc \
            websockify \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# air handles the watch/rebuild/restart loop.
RUN go install github.com/air-verse/air@latest

WORKDIR /src

# Source directory bind-mounted at /src from docker-compose.dev.yml —
# no COPY here. GOCACHE + GOMODCACHE come from named docker volumes
# (see compose) so restarts don't re-download modules.

ENTRYPOINT ["sh", "-c", "air -c .air.${BINARY}.toml"]
