# Dev image with air for hot-reload. Source is bind-mounted from the
# host in docker-compose.dev.yml; air watches for .go changes and
# rebuilds + restarts on save.
#
# One image for the worker and API binaries; docker-compose.dev.yml sets
# BINARY per service. Twitter uses docker/twitter/Dockerfile because its
# Playwright and Firefox runtime is a separate build boundary.

FROM golang:1.25.11-bookworm

ARG BINARY
ARG AIR_VERSION=1.65.3
ENV BINARY=${BINARY}

# Base runtime deps + build tools for CGO if we ever need it later.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Air handles the watch/rebuild/restart loop. Pin it so a clean dev rebuild
# cannot silently change the watcher or build behavior.
RUN go install github.com/air-verse/air@v${AIR_VERSION}

WORKDIR /src

# Source directory bind-mounted at /src from docker-compose.dev.yml —
# no COPY here. GOCACHE + GOMODCACHE come from named docker volumes
# (see compose) so restarts don't re-download modules.
#
# Single .air.toml at repo root uses ${BINARY} env-var substitution to
# pick which cmd/ package to build, so no per-binary config needed.

ENTRYPOINT ["air"]
