# found-footy .gitignore — Python-era build artifacts (still real for prod)
# plus Go rebuild build outputs, dev env, and secrets.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.idea/
*.swp
*.swo
*~
# Keep .devcontainer but ignore local settings
.devcontainer/.env
.devcontainer/settings.json

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project specific
downloads/
*.log
.pytest_cache/
.coverage
htmlcov/

# Docker
# .dockerignore

# Database
*.db
*.sqlite3

# Environment variables
.env.local
.env.production

# Temporary files
tmp/
temp/

# Development artifacts
.twitter_backup/
dumps/
dagster_storage/
dagster_logs/

# Docker development volumes
.bash_history_dir/

# Twitter cookies (SENSITIVE - never commit)
twitter_cookies_backup.json
twitter_cookies*.json
twitter_cookies*.pkl
*.pkl
.open_vnc_signal
mongodb-keyfile

# Claude Code session state (loop / wakeup tracking)
.claude/

# Go build artifacts
/bin/
*.exe
*.exe~
*.dll
*.so.[0-9]*
*.dylib
*.test
*.out
coverage.out
coverage.html
# Anchored to repo root — Go vendor dir only. Do NOT match
# docs/api-football/vendor/ (frozen vendor-doc archive).
/vendor/
# Stray root-level binaries produced by `go build ./cmd/<x>` — each
# cmd/<x> package produces an executable at repo root by default.
/worker
/api
/scaler
/twitter

# air hot-reload
tmp/
build-errors.log

# Browser-save asset dirs from vendor-doc HTML mirrors — the HTML
# references them by relative path, but they're 5+ MB of images we
# don't want in git. Keep locally, don't commit.
docs/api-football/vendor/*_files/
